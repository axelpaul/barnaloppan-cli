{
  "name": "barnaloppan-cli",
  "version": "0.2.0",
  "description": "Unofficial CLI and MCP server for Barnaloppan booth inventory and sales",
  "private": true,
  "license": "MIT",
  "author": "Axel Paul Gunnarsson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axelpaul/barnaloppan-cli.git"
  },
  "homepage": "https://github.com/axelpaul/barnaloppan-cli#readme",
  "bugs": {
    "url": "https://github.com/axelpaul/barnaloppan-cli/issues"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "type": "module",
  "module": "src/index.ts",
  "bin": {
    "barnaloppan": "src/index.ts"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "build": "bun build --compile src/index.ts --outfile barnaloppan",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "check": "bun run lint && bun run typecheck && bun run test",
    "test": "bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@types/bun": "^1.3.12",
    "typescript": "^5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  }
}
